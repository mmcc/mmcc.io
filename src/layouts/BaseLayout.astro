---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Matthew McClure's personal site", image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content="@matt_mcclure" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <nav>
          <a href="/" class="site-name">mmcc</a>
          <span class="nav-sep">/</span>
          <ul class="nav-links">
            <li><a href="/blog">posts</a></li>
            <li><a href="/oss">oss</a></li>
          </ul>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span class="footer-text">&copy; {new Date().getFullYear()}</span>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--spacing-unit) * 6) calc(var(--spacing-unit) * 4);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    margin-bottom: calc(var(--spacing-unit) * 8);
  }

  nav {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing-unit) * 2);
    font-size: 0.875rem;
  }

  .site-name {
    font-weight: 500;
    text-decoration: none;
  }

  .nav-sep {
    color: var(--color-text-muted);
    user-select: none;
  }

  .nav-links {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing-unit) * 3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links li {
    margin: 0;
  }

  .nav-links a {
    color: var(--color-text-muted);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  main {
    flex: 1;
  }

  .site-footer {
    margin-top: calc(var(--spacing-unit) * 12);
    padding-top: calc(var(--spacing-unit) * 4);
    border-top: 1px solid var(--color-border);
  }

  .footer-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
