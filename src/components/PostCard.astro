---
interface Props {
  title: string;
  description?: string;
  date: Date;
  slug: string;
  url?: string;
  source?: string;
}

const { title, description, date, slug, url, source } = Astro.props;

const formattedDate = date.toISOString().split("T")[0];
const href = url || `/blog/${slug}`;
---

<article class="post-card">
  <a href={href}>
    <div class="meta">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {source && <span class="source">{source}</span>}
    </div>
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </a>
</article>

<style>
  .post-card a {
    display: block;
    text-decoration: none;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-card time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .source {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle, rgba(128, 128, 128, 0.1));
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .post-card h3 {
    margin: calc(var(--spacing-unit) * 1) 0;
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-text);
  }

  .post-card a:hover h3 {
    opacity: 0.7;
  }

  .post-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
