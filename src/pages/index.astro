---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<BaseLayout title="mmcc">
  <section class="intro">
    <p class="greeting">Hi, I'm Matt.</p>
    <p>
      Marketing at <a href="https://mux.com">Mux</a>, building developer tools
      for video. Previously worked on developer experience, documentation, and
      communities around video infrastructure.
    </p>
    <p>I like making complex things feel simple.</p>

    <div class="links">
      <SocialLinks />
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 50ch;
  }

  .greeting {
    margin-bottom: calc(var(--spacing-unit) * 4);
  }

  .intro p {
    color: var(--color-text-muted);
  }

  .intro p a {
    color: var(--color-text);
  }

  .links {
    margin-top: calc(var(--spacing-unit) * 6);
    padding-top: calc(var(--spacing-unit) * 4);
    border-top: 1px solid var(--color-border);
  }
</style>
