---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";

const navLinks = [
  { name: "posts", url: "/blog" },
  { name: "oss", url: "/oss" },
];
---

<BaseLayout title="mmcc">
  <section class="intro">
    <p class="greeting">Hi, I'm Matt.</p>
    <p>
      Marketing at <a href="https://mux.com">Mux</a>, building developer tools
      for video. Previously worked on developer experience, documentation, and
      communities around video infrastructure.
    </p>
    <p>I like making complex things feel simple.</p>

    <nav class="nav">
      <ul>
        {navLinks.map((link, i) => (
          <>
            <li><a href={link.url}>{link.name}</a></li>
            {i < navLinks.length - 1 && <li class="sep">/</li>}
          </>
        ))}
      </ul>
    </nav>

    <div class="links">
      <SocialLinks />
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 50ch;
  }

  .greeting {
    margin-bottom: calc(var(--spacing-unit) * 4);
  }

  .intro p {
    color: var(--color-text-muted);
  }

  .intro p a {
    color: var(--color-text);
  }

  .nav {
    margin-top: calc(var(--spacing-unit) * 6);
  }

  .nav ul {
    display: flex;
    gap: calc(var(--spacing-unit) * 2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  .nav a:hover {
    opacity: 0.7;
  }

  .nav .sep {
    color: var(--color-border);
    user-select: none;
  }

  .links {
    margin-top: calc(var(--spacing-unit) * 4);
    padding-top: calc(var(--spacing-unit) * 4);
    border-top: 1px solid var(--color-border);
  }
</style>
