---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";

const navLinks = [
  { name: "posts", url: "/blog" },
  { name: "oss", url: "/oss" },
];
---

<BaseLayout title="mmcc">
  <section class="intro">
    <p class="greeting">Hi, I'm <s>Troy</s> Matt McClure.</p>
    <p>
      You may remember me from video dev stuff such as <a href="https://mux.com">Mux</a>, <a href="https://demuxed.com">Demuxed</a>, and <a href="https://sfvideo.org">SF Video</a>. I like building things for builders and also getting builders together to talk about things they're building.
    </p>
    <p>
      I was caught sitting awkwardly in a hot tub one time and <a href="https://knowyourmeme.com/memes/two-bros-chillin-in-a-hot-tub">made fun of by the Internet for it</a>.
    </p>
    <p>I've got four kids six and under and a startup, ama.</p>

    <nav class="nav">
      <ul>
        {navLinks.map((link, i) => (
          <>
            <li><a href={link.url}>{link.name}</a></li>
            {i < navLinks.length - 1 && <li class="sep">/</li>}
          </>
        ))}
      </ul>
    </nav>

    <div class="links">
      <SocialLinks />
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 50ch;
  }

  .greeting {
    margin-bottom: calc(var(--spacing-unit) * 4);
  }

  .intro p {
    color: var(--color-text-muted);
  }

  .intro p a {
    color: var(--color-text);
  }

  .nav {
    margin-top: calc(var(--spacing-unit) * 6);
  }

  .nav ul {
    display: flex;
    gap: calc(var(--spacing-unit) * 2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  .nav a:hover {
    opacity: 0.7;
  }

  .nav .sep {
    color: var(--color-border);
    user-select: none;
  }

  .links {
    margin-top: calc(var(--spacing-unit) * 4);
    padding-top: calc(var(--spacing-unit) * 4);
    border-top: 1px solid var(--color-border);
  }
</style>
