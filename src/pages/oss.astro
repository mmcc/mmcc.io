---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sparkline from "../components/Sparkline.astro";
import { getAllCommitActivity } from "../lib/github";

interface Project {
  name: string;
  repo: string;
  description: string;
  role?: string;
  stars: number;
}

// Curated list with star counts (updated Jan 2026)
const projects: Project[] = [
  {
    name: "Video.js",
    repo: "videojs/video.js",
    description: "Open source HTML5 video player",
    role: "Core team member",
    stars: 39452,
  },
  {
    name: "Media Chrome",
    repo: "muxinc/media-chrome",
    description: "Custom elements for making audio and video player controls",
    role: "Creator",
    stars: 2567,
  },
  {
    name: "next-video",
    repo: "muxinc/next-video",
    description: "The easiest way to add video in your Next.js app",
    role: "Creator",
    stars: 1176,
  },
  {
    name: "stream.new",
    repo: "muxinc/stream.new",
    description: "Record and share videos instantly",
    role: "Creator",
    stars: 583,
  },
  {
    name: "UpChunk",
    repo: "muxinc/upchunk",
    description: "Uploads Chunks! Chunked file uploads with care",
    role: "Creator",
    stars: 414,
  },
  {
    name: "Mux Elements",
    repo: "muxinc/elements",
    description: "Custom elements for working with media in the browser",
    role: "Creator",
    stars: 341,
  },
  {
    name: "player.style",
    repo: "muxinc/player.style",
    description: "A collection of media player themes",
    role: "Creator",
    stars: 244,
  },
  {
    name: "Mux Node SDK",
    repo: "muxinc/mux-node-sdk",
    description: "Official Mux API wrapper for Node.js",
    role: "Creator",
    stars: 172,
  },
  {
    name: "Mux Elixir",
    repo: "muxinc/mux-elixir",
    description: "Official Mux API wrapper for Elixir",
    role: "Creator",
    stars: 81,
  },
  {
    name: "videojs-mux-kit",
    repo: "muxinc/videojs-mux-kit",
    description: "Video.js + Mux, batteries included",
    role: "Creator",
    stars: 33,
  },
  {
    name: "hls-video-element",
    repo: "muxinc/hls-video-element",
    description: "Custom element for playing HLS videos",
    role: "Creator",
    stars: 40,
  },
  {
    name: "castable-video",
    repo: "muxinc/castable-video",
    description: "Cast your video element to the big screen",
    role: "Creator",
    stars: 25,
  },
];

function formatStars(stars: number): string {
  if (stars >= 1000) {
    return `${(stars / 1000).toFixed(1)}k`;
  }
  return stars.toString();
}

// Fetch commit activity for all repos at build time
const repos = projects.map(p => p.repo);
const activityMap = await getAllCommitActivity(repos);
---

<BaseLayout title="open source / mmcc" description="Open source projects by Matthew McClure">
  <section class="oss">
    <h1>open source</h1>
    <p class="intro">Projects I've created or helped with.</p>
    
    <ul class="projects">
      {projects.map((project) => (
        <li class="project">
          <a href={`https://github.com/${project.repo}`}>
            <div class="project-header">
              <span class="name">{project.name}</span>
              <div class="meta">
                <Sparkline data={activityMap.get(project.repo) || []} />
                <span class="stars">★ {formatStars(project.stars)}</span>
              </div>
            </div>
            <p class="description">{project.description}</p>
            {project.role && <span class="role">{project.role}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: 0.875rem;
    text-transform: lowercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: calc(var(--spacing-unit) * 2);
  }

  .intro {
    color: var(--color-text-muted);
    margin-bottom: calc(var(--spacing-unit) * 6);
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project {
    margin-bottom: calc(var(--spacing-unit) * 4);
    padding-bottom: calc(var(--spacing-unit) * 4);
    border-bottom: 1px solid var(--color-border);
  }

  .project:last-child {
    border-bottom: none;
  }

  .project a {
    display: block;
    text-decoration: none;
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: calc(var(--spacing-unit) * 1);
  }

  .name {
    font-weight: 500;
    color: var(--color-text);
  }

  .project a:hover .name {
    opacity: 0.7;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stars {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle, rgba(128, 128, 128, 0.1));
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .role {
    display: inline-block;
    margin-top: calc(var(--spacing-unit) * 1);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }
</style>
