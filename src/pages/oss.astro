function generateSparkline(data: number[]): string {
  const width = 80;
  const height = 20;
  const max = Math.max(...data, 1);
  
  const points = data.map((value, i) => {
    const x = (i / (data.length - 1)) * width;
    const y = height - (value / max) * (height - 2) - 1;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(" ");
  
  return `<svg viewBox="0 0 ${width} ${height}" width="${width}" height="${height}" class="sparkline"><polyline points="${points}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
}

function formatStars(stars: number): string {
  if (stars >= 1000) {
    return `${(stars / 1000).toFixed(1)}k`;
  }
  return stars.toString();
}

const projectsWithSparklines = projects.map(p => ({
  ...p,
  sparkline: generateSparkline(p.activity),
}));
---

<BaseLayout title="open source / mmcc" description="Open source projects by Matthew McClure">
  <section class="oss">
    <h1>open source</h1>
    <p class="intro">Projects I've created or helped with.</p>
    
    <ul class="projects">
      {projectsWithSparklines.map((project) => (
        <li class="project">
          <a href={`https://github.com/${project.repo}`}>
            <div class="project-header">
              <span class="name">{project.name}</span>
              <div class="meta">
                <Fragment set:html={project.sparkline} />
                <span class="stars">★ {formatStars(project.stars)}</span>
              </div>
            </div>
            <p class="description">{project.description}</p>
            {project.role && <span class="role">{project.role}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: 0.875rem;
    text-transform: lowercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: calc(var(--spacing-unit) * 2);
  }

  .intro {
    color: var(--color-text-muted);
    margin-bottom: calc(var(--spacing-unit) * 6);
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project {
    margin-bottom: calc(var(--spacing-unit) * 4);
    padding-bottom: calc(var(--spacing-unit) * 4);
    border-bottom: 1px solid var(--color-border);
  }

  .project:last-child {
    border-bottom: none;
  }

  .project a {
    display: block;
    text-decoration: none;
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: calc(var(--spacing-unit) * 1);
  }

  .name {
    font-weight: 500;
    color: var(--color-text);
  }

  .project a:hover .name {
    opacity: 0.7;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sparkline {
    color: var(--color-text-muted);
    opacity: 0.6;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .project-header {
      flex-wrap: wrap;
    }
    
    .meta {
      width: 100%;
      margin-top: calc(var(--spacing-unit) * 1);
    }

    .sparkline {
      width: 60px;
      height: 15px;
    }
  }

  .stars {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle, rgba(128, 128, 128, 0.1));
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .role {
    display: inline-block;
    margin-top: calc(var(--spacing-unit) * 1);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }
</style>
